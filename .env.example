# CrimeNet AI Environment Variables

# API access (required for every /api/* request)
# Generate a long random value for real deployments.
CRIMENET_API_KEY=replace_with_a_long_random_api_key
CRIMENET_OFFICER_BADGES=INSP-4409

# Explicit browser origins only; wildcard origins are not accepted.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# LLM settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
OPENAI_API_KEY=
HOST=0.0.0.0
PORT=8000
